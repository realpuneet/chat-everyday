# Frontend build/runtime configuration (Vite exposes only VITE_* variables).
# Leave API/Socket URLs blank to use the same origin (dev: Vite proxy, prod: nginx reverse proxy).
VITE_API_URL=
VITE_SOCKET_URL=
# Google Sign-In (Web client ID). Blank => dry-run mode: type an email, no real Google call.
VITE_GOOGLE_CLIENT_ID=
# Show developer helpers (dry-run Google/OTP hints). Never enable in production builds.
VITE_DRYRUN=true
# Dev proxy target for `npm run dev`
VITE_PROXY_TARGET=http://127.0.0.1:4000
