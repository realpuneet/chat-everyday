# =============================================================================
# Chat Everyday API / worker configuration.  Copy to `.env` (never commit it).
# Anything left BLANK for an external service runs in DRY-RUN mode (see docs/environment.md).
# =============================================================================

# ---- core ----
NODE_ENV=development            # development | test | production
PORT=4000
INSTANCE_ID=                    # optional, defaults to a random id (shown in logs / presence)
LOG_LEVEL=info
PUBLIC_URL=http://localhost:4000   # public base URL of the API (used for local signed image URLs)
CORS_ORIGINS=http://localhost:5173 # comma separated allow-list of browser origins
TRUST_PROXY=0                   # number of reverse proxies in front (nginx/ALB => 1) so req.ip is correct

# ---- data stores ----
MONGO_URI=mongodb://127.0.0.1:27017/chat_everyday
REDIS_URL=redis://127.0.0.1:6379   # run Redis with maxmemory-policy noeviction (queues + matching live here)

# ---- secrets (REQUIRED in production; generate each with: openssl rand -hex 32) ----
JWT_ACCESS_SECRET=
JWT_GUEST_SECRET=
PEPPER=                         # HMAC key for hashing IPs / devices / phones. Rotating it invalidates existing bans.
URL_SIGNING_SECRET=
ENCRYPTION_KEY=                 # base64 of exactly 32 bytes: openssl rand -base64 32  (saved-chat encryption)

# ---- sessions ----
ACCESS_TTL_SEC=900
GUEST_TTL_SEC=21600
GUEST_MAX_SESSION_SEC=86400
REFRESH_TTL_SEC=2592000
COOKIE_SECURE=                  # blank => true in production, false otherwise
COOKIE_SAMESITE=lax             # lax | strict | none (none requires HTTPS + COOKIE_SECURE)

# ---- auth providers ----
ADMIN_EMAILS=                   # comma list; promoted to admin ONLY via Google sign-in with a verified email
GOOGLE_CLIENT_ID=               # blank => dry-run (token format "dryrun:<email>", non-production only)

OTP_PROVIDER=console            # console (dry-run) | twilio | msg91 | firebase
OTP_ALLOWED_COUNTRY_CODES=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=              # DLT-registered template (India)
FIREBASE_PROJECT_ID=

# ---- image storage (bucket MUST be private; read the provider's adult-content policy first) ----
STORAGE_PROVIDER=local          # local (dry-run) | s3 | imagekit
LOCAL_STORAGE_DIR=./.data/uploads
S3_ENDPOINT=                    # R2: https://<account>.r2.cloudflarestorage.com | MinIO: http://minio:9000 | AWS: blank
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---- moderation hooks (blank/dryrun => no external calls) ----
MODERATION_PROVIDER=dryrun      # dryrun | http   (NSFW classifier, see docs/security.md for the contract)
MODERATION_HTTP_URL=
MODERATION_HTTP_KEY=
HASHMATCH_PROVIDER=dryrun       # dryrun | http   (known-bad hash matching: PhotoDNA / StopNCII-style service)
HASHMATCH_HTTP_URL=
HASHMATCH_HTTP_KEY=
AGE_VERIFY_PROVIDER=dryrun      # dryrun | http   (stricter age verification for adult rooms)
AGE_VERIFY_HTTP_URL=
AGE_VERIFY_HTTP_KEY=
IP_RISK_PROVIDER=dryrun         # dryrun | http   (VPN / datacenter detection for ban-evasion score)
IP_RISK_HTTP_URL=
IP_RISK_HTTP_KEY=

# ---- video (WebRTC) ----
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=                      # e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_SECRET=                    # must equal coturn's static-auth-secret
TURN_TTL_SEC=3600

# ---- process behaviour ----
RUN_WORKER_INLINE=true          # run the image worker inside the API process (set false when running `npm run start:worker`)
DISABLE_SWEEPER=false           # background maintenance loops (disable only in tests)
RATE_LIMIT_MULTIPLIER=1         # >1 ONLY for load tests / CI; never in production
